[configuration]

entry_symbol = "protodish_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://bin/libprotodish.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libprotodish.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/libprotodish.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libprotodish.windows.template_release.x86_64.dll"
